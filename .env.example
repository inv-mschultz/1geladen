DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional: register a free key at developers.giphy.com (falls back to GIPHY public beta key)
NEXT_PUBLIC_GIPHY_API_KEY=

# Optional: push notifications. Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hallo@1geladen.de

# Daily gallery cleanup (Vercel Cron). Any long random string.
CRON_SECRET=
